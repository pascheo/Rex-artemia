generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  nom        String
  direction  String
  role       Role       @default(USER)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  responses  Response[]
  auditLogs  AuditLog[]
}

model Response {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  casUsage    String
  scores      Json
  openG1      String?
  openG2      String?
  openG3      String?
  openG4      String?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId])
}

model CollectionConfig {
  id        Int      @id @default(1)
  isOpen    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())
}
